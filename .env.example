# Variáveis do servidor (server/index.js). No Coolify, configure em Environment Variables.

# PostgreSQL. Sem esta variável o servidor usa o PGlite local em ./.data/pglite (só desenvolvimento).
DATABASE_URL=postgres://usuario:senha@host:5432/gordinho_brindes

# PIN inicial do painel /admin. Usado apenas na primeira execução, quando ainda não existe credencial
# no banco; depois disso o PIN é trocado pelo próprio painel (Configurações > Segurança).
ADMIN_PIN=troque-este-pin

# Segredo para assinar as sessões do painel (string longa e aleatória).
SESSION_SECRET=gere-uma-string-aleatoria-longa

# Porta HTTP (o Coolify espera 3000).
PORT=3000
